page {
  height: 100%;
  background: #f5f7fa;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: #1f2933;
  box-sizing: border-box;
}
view, input, scroll-view { box-sizing: border-box; }

/* 通用小部件 */
.shadow { box-shadow: 0 4rpx 16rpx rgba(16, 42, 67, 0.18); }
.tag { margin-right: 10rpx; padding: 2rpx 14rpx; font-size: 22rpx; color: #3e4c59; background: #e4e7eb; border-radius: 6rpx; }
.dot { flex: none; width: 18rpx; height: 18rpx; border-radius: 50%; }
.btn { flex: 1; line-height: 84rpx; text-align: center; font-size: 30rpx; font-weight: 500; color: #ffffff; background: #0d47a1; border-radius: 16rpx; }
.btn-ghost { color: #0d47a1; background: #ffffff; border: 3rpx solid #0d47a1; line-height: 78rpx; }
.btn-hover { opacity: 0.8; }
.btn-row { display: flex; gap: 20rpx; }

.facts { display: flex; flex-wrap: wrap; justify-content: space-between; }
.fact { width: 48.5%; margin-bottom: 14rpx; padding: 14rpx 20rpx; background: #f5f7fa; border-radius: 12rpx; }
.fact-k { font-size: 22rpx; color: #52606d; }
.fact-v { margin-top: 2rpx; font-size: 28rpx; font-weight: 500; }

.sheet { position: absolute; left: 0; right: 0; bottom: 0; padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); background: #ffffff; border-radius: 36rpx 36rpx 0 0; box-shadow: 0 -8rpx 32rpx rgba(16, 42, 67, 0.2); }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 20rpx; border-radius: 4rpx; background: #cbd2d9; }
.sheet-head { display: flex; align-items: center; margin-bottom: 20rpx; }
.sheet-title { margin-right: 16rpx; font-size: 38rpx; font-weight: 700; }
.sheet-close { margin-left: auto; width: 72rpx; line-height: 72rpx; text-align: center; font-size: 32rpx; color: #52606d; }
.sheet-desc { margin: 6rpx 0 24rpx; font-size: 28rpx; line-height: 1.6; color: #3e4c59; }

.progress { flex: 1; height: 12rpx; border-radius: 6rpx; background: #e4e7eb; overflow: hidden; }
.progress-bar { height: 12rpx; background: #2e7d32; }

.panel { margin: 24rpx; background: #ffffff; border: 1rpx solid #e4e7eb; border-radius: 24rpx; overflow: hidden; }
.panel-head { display: flex; align-items: center; gap: 20rpx; padding: 24rpx; }
.panel-title { font-size: 30rpx; font-weight: 700; }
.panel-sub { font-size: 24rpx; color: #52606d; }
.row { display: flex; align-items: center; gap: 24rpx; min-height: 112rpx; padding: 0 24rpx; border-top: 1rpx solid #e4e7eb; }
.row-hover { background: #f5f7fa; }
.row-main { flex: 1; }
.row-name { font-size: 32rpx; font-weight: 500; }
.row-sub { font-size: 24rpx; color: #52606d; }
.row-done { font-size: 24rpx; color: #2e7d32; }
.row-arrow { font-size: 36rpx; color: #7b8794; }
.empty { padding: 40rpx 24rpx; text-align: center; font-size: 26rpx; color: #52606d; }
