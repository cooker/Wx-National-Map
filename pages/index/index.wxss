.page { position: relative; width: 100%; height: 100vh; overflow: hidden; }
.map { width: 100%; height: 100%; }

/* ---------- 顶部 ---------- */
.top { position: absolute; left: 24rpx; right: 24rpx; top: 24rpx; }
.search { display: flex; align-items: center; height: 84rpx; padding: 0 28rpx; background: #ffffff; border-radius: 42rpx; }
.search-input { flex: 1; margin-left: 16rpx; font-size: 28rpx; }
.search-ph { color: #7b8794; }
.search-clear { width: 64rpx; line-height: 64rpx; text-align: center; color: #52606d; }

.results { margin-top: 16rpx; background: #ffffff; border-radius: 20rpx; overflow: hidden; }
.result { display: flex; align-items: center; gap: 20rpx; height: 96rpx; padding: 0 28rpx; border-top: 1rpx solid #e4e7eb; }
.result:first-child { border-top: 0; }
.result-name { font-size: 30rpx; font-weight: 500; }
.result-sub { margin-left: auto; font-size: 24rpx; color: #52606d; }

/* 分类筛选：横向滑动。scroll-view 必须给固定高度，否则内容会被裁掉一半 */
.chips { width: 100%; height: 80rpx; margin-top: 16rpx; white-space: nowrap; }
.chip { display: inline-flex; align-items: center; height: 64rpx; margin: 6rpx 12rpx 0 0; padding: 0 22rpx; font-size: 26rpx; vertical-align: top; background: #ffffff; border: 1rpx solid #d9e0e7; border-radius: 32rpx; }
.chip .dot { margin-right: 10rpx; width: 16rpx; height: 16rpx; }
.chip-on { color: #1f2933; font-weight: 500; }
.chip-idle { color: #52606d; }
.chip-off { color: #7b8794; background: #f0f3f6; }

.legend { display: inline-flex; align-items: center; gap: 24rpx; margin-top: 12rpx; margin-right: 16rpx; padding: 10rpx 20rpx; font-size: 24rpx; color: #1f2933; background: #ffffff; border: 1rpx solid #d9e0e7; border-radius: 12rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; }
.legend-box { width: 28rpx; height: 20rpx; border-radius: 4rpx; }

/* ---------- 右侧工具条：三组按钮，同一种样式 ---------- */
.side { position: absolute; right: 24rpx; top: 232rpx; display: flex; flex-direction: column; gap: 16rpx; }
.tool { width: 84rpx; background: #ffffff; border: 1rpx solid #d9e0e7; border-radius: 16rpx; overflow: hidden; box-shadow: 0 2rpx 10rpx rgba(16, 42, 67, 0.16); }
.tbtn { position: relative; width: 84rpx; height: 84rpx; line-height: 84rpx; text-align: center; font-size: 26rpx; font-weight: 500; color: #0d47a1; border-top: 1rpx solid #e4e7eb; }
.tbtn:first-child { border-top: 0; }
.tbtn-hover { background: #eef3f9; }
.tbtn-main { color: #ffffff; background: #0d47a1; }
.tbtn-main-hover { background: #0a3a85; }
/* 加号、减号用两根线画，比全角符号清楚 */
.ico-h, .ico-v { position: absolute; left: 50%; top: 50%; background: #0d47a1; border-radius: 2rpx; }
.ico-h { width: 32rpx; height: 4rpx; margin: -2rpx 0 0 -16rpx; }
.ico-v { width: 4rpx; height: 32rpx; margin: -16rpx 0 0 -2rpx; }
.zlevel { height: 44rpx; line-height: 44rpx; text-align: center; font-size: 24rpx; font-weight: 700; color: #1f2933; background: #f0f3f6; border-top: 1rpx solid #e4e7eb; }

/* ---------- 底部缩放条 ---------- */
.bottom { position: absolute; left: 24rpx; right: 24rpx; bottom: 24rpx; padding: 16rpx 24rpx 8rpx; background: #ffffff; border: 1rpx solid #d9e0e7; border-radius: 20rpx; box-shadow: 0 2rpx 10rpx rgba(16, 42, 67, 0.16); }
.bar-head { display: flex; align-items: baseline; justify-content: space-between; }
.bar-tier { font-size: 26rpx; font-weight: 700; color: #1f2933; }
.bar-info { font-size: 22rpx; color: #52606d; }
.slider-row { display: flex; align-items: center; }
.slider { flex: 1; margin: 10rpx 20rpx; }
.slider-label { font-size: 24rpx; color: #52606d; }

/* ---------- 知识卡片 ---------- */
.sheet { max-height: 78vh; overflow-y: auto; }
.points { margin: -8rpx 0 24rpx; }
.points-title { margin-bottom: 8rpx; font-size: 24rpx; color: #52606d; }
.point { position: relative; padding-left: 28rpx; font-size: 28rpx; line-height: 1.7; color: #1f2933; }
.point::before { content: ""; position: absolute; left: 6rpx; top: 20rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: #b84300; }
.lesson-point { font-size: 30rpx; }
.data-note { margin: -12rpx 0 20rpx; font-size: 22rpx; color: #7b8794; }

/* ---------- 专题课 ---------- */
.lesson-bar { padding: 20rpx 24rpx; background: #ffffff; border: 1rpx solid #d9e0e7; border-radius: 20rpx; }
.lesson-bar-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.lesson-bar-tag { padding: 2rpx 14rpx; font-size: 22rpx; color: #ffffff; background: #0d47a1; border-radius: 8rpx; }
.lesson-bar-title { flex: 1; font-size: 32rpx; font-weight: 700; }
.lesson-bar-count { font-size: 28rpx; color: #52606d; }
.lesson-exit { padding: 0 24rpx; line-height: 60rpx; font-size: 26rpx; color: #0d47a1; border: 2rpx solid #b9c7d8; border-radius: 12rpx; }
.lesson-progress { background: #0d47a1; }
.lesson-intro { margin-bottom: 20rpx; padding: 16rpx 20rpx; font-size: 26rpx; line-height: 1.6; color: #3e4c59; background: #eef3f9; border-radius: 12rpx; }
.lesson-no { flex: none; width: 56rpx; margin-right: 16rpx; line-height: 56rpx; text-align: center; font-size: 30rpx; font-weight: 700; color: #ffffff; border-radius: 50%; }
.lesson-name { font-size: 46rpx; }
.lesson-note { margin-bottom: 16rpx; font-size: 34rpx; font-weight: 700; color: #b84300; }
.lesson-desc { font-size: 32rpx; }
.fav { margin-left: auto; padding: 0 12rpx; line-height: 72rpx; font-size: 26rpx; color: #0d47a1; }
.btn-disabled { opacity: 0.4; }
.lesson-list { max-height: 60vh; }
.lesson-row { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; border-top: 1rpx solid #e4e7eb; }
.lesson-count { flex: none; font-size: 24rpx; color: #52606d; }

/* ---------- 图层面板 ---------- */
.mask { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background: rgba(16, 42, 67, 0.4); }
.layer-scroll { max-height: 64vh; }
.layer-label { margin: 8rpx 0 16rpx; font-size: 26rpx; color: #52606d; }
.tiles { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.tile { flex: 1; border: 4rpx solid #e4e7eb; border-radius: 16rpx; overflow: hidden; text-align: center; }
.tile-on { border-color: #0d47a1; }
.tile-on .tile-name { color: #0d47a1; font-weight: 700; }
.tile-pic { height: 96rpx; }
.tile-std { background: #cfe3f2; border-bottom: 40rpx solid #f6e4b4; }
.tile-sat { background: #16324a; border-bottom: 40rpx solid #3f6b4a; }
.tile-name { padding: 12rpx 0; font-size: 26rpx; }
.layer-row { display: flex; align-items: center; gap: 20rpx; min-height: 96rpx; padding: 8rpx 0; border-top: 1rpx solid #e4e7eb; }
.layer-name { flex: 1; font-size: 30rpx; }
.layer-sub { font-size: 22rpx; color: #52606d; }

.sheet-meta { margin: -8rpx 0 12rpx; font-size: 24rpx; color: #52606d; }

/* 气候图例 */
.legend-note { margin: -8rpx 0 16rpx; font-size: 24rpx; color: #52606d; }
.clim-row { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 0; border-top: 1rpx solid #e4e7eb; }
.clim-box { flex: none; width: 56rpx; height: 40rpx; border-radius: 8rpx; }
.clim-name { font-size: 30rpx; font-weight: 500; }
