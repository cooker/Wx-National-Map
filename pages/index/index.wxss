.page { position: relative; width: 100%; height: 100vh; overflow: hidden; }
.map { width: 100%; height: 100%; }

/* 顶部 */
.top { position: absolute; left: 24rpx; right: 24rpx; top: 24rpx; }
.search { display: flex; align-items: center; height: 88rpx; padding: 0 28rpx; background: #ffffff; border-radius: 44rpx; }
.search-input { flex: 1; margin-left: 16rpx; font-size: 28rpx; }
.search-ph { color: #7b8794; }
.search-clear { width: 64rpx; line-height: 64rpx; text-align: center; color: #52606d; }

.results { margin-top: 16rpx; background: #ffffff; border-radius: 24rpx; overflow: hidden; }
.result { display: flex; align-items: center; gap: 20rpx; height: 96rpx; padding: 0 28rpx; border-top: 1rpx solid #e4e7eb; }
.result:first-child { border-top: 0; }
.result-name { font-size: 30rpx; font-weight: 500; }
.result-sub { margin-left: auto; font-size: 24rpx; color: #52606d; }

.chips { display: flex; gap: 16rpx; margin-top: 20rpx; }
.chip { display: flex; align-items: center; gap: 12rpx; height: 72rpx; padding: 0 24rpx; font-size: 26rpx; border-radius: 36rpx; }
.chip-on { background: #ffffff; color: #1f2933; font-weight: 500; }
.chip-idle { background: rgba(255, 255, 255, 0.85); color: #3e4c59; }
.chip-off { background: rgba(255, 255, 255, 0.7); color: #52606d; text-decoration: line-through; }

/* 右侧按钮 */
.side { position: absolute; right: 24rpx; top: 240rpx; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.sbtn { width: 88rpx; height: 88rpx; line-height: 88rpx; text-align: center; font-size: 44rpx; color: #0d47a1; background: #ffffff; border-radius: 24rpx; box-shadow: 0 4rpx 16rpx rgba(16, 42, 67, 0.25); }
.sbtn-text { font-size: 26rpx; }
.sbtn-flat { box-shadow: none; background: transparent; }
.sbtn-hover { background: #e3f2fd; }
.zgroup { display: flex; flex-direction: column; align-items: center; background: #ffffff; border-radius: 24rpx; box-shadow: 0 4rpx 16rpx rgba(16, 42, 67, 0.25); }
.zlevel { min-width: 56rpx; padding: 0 12rpx; text-align: center; font-size: 24rpx; font-weight: 700; line-height: 36rpx; color: #ffffff; background: #0d47a1; border-radius: 18rpx; }

/* 底部 */
.bottom { position: absolute; left: 24rpx; right: 24rpx; bottom: 24rpx; }
.center-pill { display: inline-block; margin-bottom: 16rpx; padding: 4rpx 16rpx; font-size: 22rpx; line-height: 1.6; color: #ffffff; background: rgba(16, 42, 67, 0.82); border-radius: 12rpx; }
.tier { padding: 20rpx 24rpx; background: #ffffff; border-radius: 24rpx; }
.steps { display: flex; align-items: center; gap: 8rpx; }
.step { flex: 1; padding: 10rpx 0; text-align: center; font-size: 24rpx; color: #52606d; background: #eef2f6; border-radius: 12rpx; }
.step-on { color: #ffffff; font-weight: 700; background: #0d47a1; }
.step-arrow { color: #7b8794; }
.slider-row { display: flex; align-items: center; margin-top: 8rpx; }
.slider { flex: 1; margin: 12rpx 20rpx; }
.slider-label { font-size: 24rpx; color: #52606d; }
.tier-tip { font-size: 24rpx; color: #52606d; }

/* 图层面板 */
.mask { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background: rgba(16, 42, 67, 0.4); }
.layer-label { margin: 8rpx 0 16rpx; font-size: 26rpx; color: #52606d; }
.tiles { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.tile { flex: 1; border: 4rpx solid #e4e7eb; border-radius: 20rpx; overflow: hidden; text-align: center; }
.tile-on { border-color: #0d47a1; }
.tile-on .tile-name { color: #0d47a1; font-weight: 700; }
.tile-pic { height: 96rpx; }
.tile-std { background: #cfe3f2; border-bottom: 40rpx solid #f6e4b4; }
.tile-sat { background: #16324a; border-bottom: 40rpx solid #3f6b4a; }
.tile-name { padding: 12rpx 0; font-size: 26rpx; }
.layer-row { display: flex; align-items: center; gap: 20rpx; min-height: 96rpx; border-top: 1rpx solid #e4e7eb; }
.layer-name { flex: 1; font-size: 30rpx; }
.layer-sub { font-size: 22rpx; color: #52606d; }
