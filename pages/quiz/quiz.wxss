.intro { padding: 32rpx; }
.intro-title { font-size: 40rpx; font-weight: 700; }
.intro-desc { margin-top: 12rpx; font-size: 28rpx; line-height: 1.6; color: #3e4c59; }
.label { margin: 32rpx 0 16rpx; font-size: 26rpx; color: #52606d; }
.scopes { display: flex; flex-wrap: wrap; gap: 16rpx; }
.scope { width: 198rpx; padding: 20rpx 0; text-align: center; border: 3rpx solid #e4e7eb; border-radius: 20rpx; }
.scope-on { border-color: #5e35b1; background: #ede7f6; }
.scope-name { font-size: 30rpx; font-weight: 500; }
.scope-on .scope-name { color: #5e35b1; font-weight: 700; }
.scope-count { margin-top: 4rpx; font-size: 22rpx; color: #52606d; }
.summary { margin: 32rpx 0 20rpx; font-size: 26rpx; color: #52606d; }
.score { font-size: 32rpx; font-weight: 700; color: #5e35b1; }
.topics { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 20rpx; }
.topic { width: 48.5%; margin-bottom: 16rpx; padding: 18rpx 20rpx; border: 3rpx solid #e4e7eb; border-radius: 20rpx; }
