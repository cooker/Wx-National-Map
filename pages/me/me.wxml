<view class="panel">
  <view class="panel-head"><text class="panel-title">学习进度</text><text class="panel-sub">在地图上点开过卡片就算已学</text></view>
  <view class="row" wx:for="{{progress}}" wx:key="label">
    <view class="dot" style="background: {{item.color}}"></view>
    <text class="bar-label">{{item.label}}</text>
    <view class="progress"><view class="progress-bar" style="width: {{item.pct}}%"></view></view>
    <text class="bar-text">{{item.text}}</text>
  </view>
</view>

<view class="panel">
  <view class="panel-head"><text class="panel-title">需要复习</text><text class="panel-sub">测验里没有一次找对的国家</text></view>
  <view class="row" wx:for="{{review}}" wx:key="id">
    <view class="dot" style="background: {{item.color}}"></view>
    <view class="row-main" data-id="{{item.id}}" bindtap="onRowTap">
      <view class="row-name">{{item.name}}</view>
      <view class="row-sub">{{item.sub}}</view>
    </view>
    <view class="link" data-name="{{item.name}}" bindtap="onReviewed">已掌握</view>
  </view>
  <view wx:if="{{!review.length}}" class="empty">暂时没有需要复习的国家</view>
</view>

<view class="panel">
  <view class="panel-head"><text class="panel-title">学习清单</text><text class="panel-sub">在知识卡片上加入</text></view>
  <view class="row" hover-class="row-hover" wx:for="{{favs}}" wx:key="id" data-id="{{item.id}}" bindtap="onRowTap">
    <view class="dot" style="background: {{item.color}}"></view>
    <view class="row-main">
      <view class="row-name">{{item.name}}</view>
      <view class="row-sub">{{item.sub}}</view>
    </view>
    <text class="row-arrow">›</text>
  </view>
  <view wx:if="{{!favs.length}}" class="empty">学习清单还是空的</view>
</view>

<view class="clear" bindtap="clearAll">清空学习记录</view>
