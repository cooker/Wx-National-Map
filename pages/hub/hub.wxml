<view class="page">
  <image class="bg" src="/images/lake.jpg" mode="widthFix" />
  <view class="body">
    <view class="hero skyblue">
      <view class="en">CHALLENGE HUB</view>
      <view class="h1">出发去探险</view>
      <view class="lead">限时答题，或慢慢拼出一个国家。</view>
      <image class="guide" src="/images/explorer.png" mode="aspectFit" />
    </view>

    <view class="modecard purplecard" hover-class="btn-hover" bindtap="startMix">
      <view class="num">01 / 混合挑战</view>
      <view class="mc-title">限时闯关</view>
      <text class="mc-text">地图 5 题＋国旗 5 题\n每题 30 秒 · 3 颗爱心</text>
      <view class="heroicon">🏆</view>
    </view>
    <view class="modecard greencard" hover-class="btn-hover" bindtap="puzzles">
      <view class="num">02 / 轮廓练习</view>
      <view class="mc-title">国家拼图</view>
      <text class="mc-text">把碎片拼成一个国家\n4 / 6 / 9 片 · 不限时</text>
      <view class="heroicon">🧩</view>
    </view>

    <view class="panel">
      <view class="sect"><view class="h2">收到同学的邀请？</view></view>
      <view class="leadcopy">输入挑战码，就能从头独立挑战同一套内容。</view>
      <view class="space"></view>
      <view class="row">
        <input class="code-input" value="{{input}}" placeholder="输入 6 位挑战码" maxlength="6" bindinput="onInput" confirm-type="done" bindconfirm="useCode" />
        <view class="btn smallbtn" hover-class="btn-hover" bindtap="useCode">核对</view>
      </view>
    </view>

    <view class="ribbon"><text class="b">探险小贴士</text><text>拼图拖错不会扣心</text></view>
  </view>

  <view class="foot">
    <view class="btn purple" hover-class="btn-hover" bindtap="startMix">开始限时挑战</view>
    <view class="btn green" hover-class="btn-hover" bindtap="puzzles">去选拼图</view>
  </view>
</view>
