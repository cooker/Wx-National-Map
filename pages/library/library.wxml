<view class="head">
  <view class="search">
    <icon type="search" size="16" color="#52606d" />
    <input class="search-input" placeholder="搜索名称或首都" value="{{keyword}}" bindinput="onSearchInput" />
  </view>
  <view class="seg">
    <view wx:for="{{tabs}}" wx:key="*this" data-i="{{index}}" bindtap="onTab"
          class="seg-item {{index === tab ? 'seg-on' : ''}}">{{item}}</view>
  </view>
  <scroll-view wx:if="{{tab === 0}}" class="conts" scroll-x enable-flex>
    <view wx:for="{{continents}}" wx:key="*this" data-name="{{item}}" bindtap="onContinent"
          class="cont {{item === continent ? 'cont-on' : ''}}">{{item}}</view>
  </scroll-view>
</view>

<view class="panel" wx:for="{{groups}}" wx:key="title" wx:for-item="g">
  <view class="panel-head">
    <text class="panel-title">{{g.title}}</text>
    <text class="panel-sub">{{g.sub}}</text>
    <view class="progress"><view class="progress-bar" style="width: {{g.pct}}%"></view></view>
  </view>
  <view class="row" hover-class="row-hover" wx:for="{{g.items}}" wx:key="id" data-id="{{item.id}}" bindtap="onRowTap">
    <view class="dot" style="background: {{item.color}}"></view>
    <view class="row-main">
      <view class="row-name">{{item.name}}</view>
      <view class="row-sub line1">{{item.sub}}</view>
    </view>
    <text wx:if="{{item.learned}}" class="row-done">✓ 已学</text>
    <text class="row-arrow">›</text>
  </view>
</view>
<view wx:if="{{!groups.length}}" class="empty">没有找到“{{keyword}}”</view>
