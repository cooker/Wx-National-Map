.pz { padding: 50rpx 30rpx 24rpx; }
.pz-area { position: relative; width: 100%; padding-bottom: 100%; }
.pz-base, .pz-piece { position: absolute; }
.pz-base { left: 0; top: 0; width: 100%; height: 100%; }
.pz-slot { position: absolute; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 800; color: #1d5f8a; background: #ffffff66; border: 4rpx dashed #2f86c5; border-radius: 16rpx; }

.pieces { display: flex; flex-wrap: wrap; gap: 16rpx; }
.piece { width: 30.5%; padding: 10rpx 8rpx 8rpx; text-align: center; background: #fffbf0; border: 3rpx dashed #cbb992; border-radius: 26rpx; }
.piece.on { background: #e3f3d5; border: 4rpx solid #57a849; }
.piece.ghost { opacity: 0.3; }
.piece-img { width: 100%; height: 150rpx; }
.piece-name { font-size: 22rpx; font-weight: 800; color: #6b5537; }
.float { position: fixed; z-index: 30; pointer-events: none; opacity: 0.92; }
