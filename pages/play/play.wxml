<!-- 答题中 -->
<view wx:if="{{!result}}" class="page">
  <map
    id="quizMap"
    class="map"
    longitude="{{longitude}}"
    latitude="{{latitude}}"
    scale="{{scale}}"
    min-scale="{{minZoom}}"
    max-scale="{{maxZoom}}"
    markers="{{markers}}"
    enable-zoom
    enable-scroll
    enable-rotate="{{false}}"
    bindregionchange="onRegionChange"
    bindmarkertap="onMarkerTap"
    bindcallouttap="onMarkerTap"
  ></map>

  <view class="qcard shadow">
    <view class="q-top">
      <text class="q-meta">第 {{q.index + 1}} / {{q.total}} 题</text>
      <view class="progress"><view class="progress-bar q-bar" style="width: {{q.pct}}%"></view></view>
      <text class="q-score">得分 {{q.score}}</text>
    </view>
    <view class="q-text">请在地图上点出：<text class="q-target">{{q.target}}</text></view>
    <view class="q-tip">可以拖动和缩放地图，点紫色圆点作答</view>
  </view>

  <view class="side">
    <view class="zgroup">
      <view class="sbtn" hover-class="sbtn-hover" bindtap="zoomIn">＋</view>
      <view class="zlevel">{{zoom}}</view>
      <view class="sbtn" hover-class="sbtn-hover" bindtap="zoomOut">－</view>
    </view>
  </view>

  <view wx:if="{{!q.solved}}" class="actions">
    <view class="abtn abtn-hint shadow" hover-class="btn-hover" bindtap="hint">给我提示</view>
    <view class="abtn shadow" hover-class="btn-hover" bindtap="skip">跳过这题</view>
  </view>

  <view wx:if="{{q.solved}}" class="sheet">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <text class="sheet-title">{{q.skipped ? '答案：' : '找对了：'}}{{q.solved.name}}</text>
      <text class="tag">{{q.solved.continent}}</text>
      <text wx:if="{{q.first}}" class="plus">+1 分</text>
    </view>
    <view class="facts">
      <view class="fact" wx:for="{{q.solved.facts}}" wx:key="k">
        <view class="fact-k">{{item.k}}</view>
        <view class="fact-v">{{item.v}}</view>
      </view>
    </view>
    <view class="sheet-desc">{{q.solved.desc}}</view>
    <view class="btn-row">
      <view class="btn" hover-class="btn-hover" bindtap="next">{{q.index + 1 < q.total ? '下一题' : '查看成绩'}}</view>
    </view>
  </view>
</view>

<!-- 成绩 -->
<scroll-view wx:else class="result" scroll-y>
  <view class="panel summary">
    <view class="ring" style="background: conic-gradient(#2e7d32 {{result.pct}}%, #e4e7eb 0)">
      <view class="ring-inner">
        <view class="ring-num">{{result.score}}<text class="ring-total"> / {{result.total}}</text></view>
        <view class="ring-label">一次找对</view>
      </view>
    </view>
    <view class="summary-text">
      <view class="summary-title">测验完成</view>
      <view class="summary-desc">{{result.total}} 道题中，你一次就找对了 {{result.score}} 个国家。<text wx:if="{{result.wrongCount}}">还有 {{result.wrongCount}} 个已放进“我的 · 需要复习”。</text></view>
    </view>
  </view>

  <view class="label">本次题目</view>
  <view class="rows">
    <view class="rrow" wx:for="{{result.rows}}" wx:key="id">
      <text class="mark {{item.ok ? 'mark-ok' : 'mark-no'}}">{{item.ok ? '✓' : '✕'}}</text>
      <text class="rname">{{item.name}}</text>
    </view>
  </view>

  <view class="result-btns">
    <view wx:if="{{result.wrongCount}}" class="btn-row">
      <view class="btn" hover-class="btn-hover" bindtap="reviewWrong">到地图上复习答错的国家</view>
    </view>
    <view class="btn-row">
      <view class="btn btn-ghost" hover-class="btn-hover" bindtap="again">再来一次</view>
      <view class="btn btn-ghost" hover-class="btn-hover" bindtap="backToMap">回到地图</view>
    </view>
  </view>
</scroll-view>
